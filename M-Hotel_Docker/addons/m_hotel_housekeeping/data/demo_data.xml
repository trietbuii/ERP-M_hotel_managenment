<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Nhiệm vụ 1: Dọn phòng P.102 (Phòng đơn vừa trả) -->
        <record id="task_demo_1" model="hotel.housekeeping.task">
            <field name="room_id" ref="m_hotel_base.room_102"/>
            <field name="task_type">checkout_clean</field>
            <field name="priority">2</field>
            <field name="state">pending</field>
            <field name="notes">Khách vừa trả phòng lúc 12:00, cần dọn gấp chuẩn bị đón lượt khách tiếp theo.</field>
        </record>

        <!-- Sự cố 1: P.205 Bị rò rỉ vòi sen phòng tắm (Khóa phòng bảo trì) -->
        <record id="incident_demo_1" model="hotel.incident">
            <field name="title">Hỏng van vòi sen nóng lạnh</field>
            <field name="room_id" ref="m_hotel_base.room_205"/>
            <field name="severity">critical</field>
            <field name="block_room" eval="True"/>
            <field name="state">in_progress</field>
            <field name="description">Van nóng lạnh bị rò rỉ nước xuống sàn nhà tắm, cần thợ kỹ thuật thay van mới.</field>
        </record>
    </data>
</odoo>
