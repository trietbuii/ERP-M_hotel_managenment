<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban View Theo Các Giai Đoạn Dọn Buồng -->
    <record id="view_hotel_housekeeping_task_kanban" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.kanban</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="room_id"/>
                <field name="task_type"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="date_deadline"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2 shadow-sm rounded border bg-white">
                            <div class="o_kanban_record_top mb-1">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title text-primary fs-6">
                                        <field name="room_id"/>
                                    </strong>
                                    <span class="text-muted small d-block">
                                        <field name="name"/>
                                    </span>
                                </div>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="o_kanban_record_body my-1">
                                <div class="small fw-semibold"><field name="task_type"/></div>
                                <div t-if="record.user_id.raw_value" class="text-muted small">
                                    <i class="fa fa-user me-1" title="Nhân viên dọn dẹp"/>
                                    <field name="user_id"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2 pt-1 border-top d-flex justify-content-between align-items-center">
                                <span class="small text-muted"><field name="date_deadline"/></span>
                                <div class="btn-group btn-group-sm">
                                    <button t-if="record.state.raw_value == 'pending'" name="action_start" type="object" class="btn btn-outline-primary btn-sm py-0 px-1" title="Bắt đầu dọn">
                                        <i class="fa fa-play" title="Bắt đầu dọn"/>
                                    </button>
                                    <button t-if="record.state.raw_value == 'in_progress'" name="action_complete" type="object" class="btn btn-outline-success btn-sm py-0 px-1" title="Hoàn thành sạch">
                                        <i class="fa fa-check" title="Hoàn thành"/>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_hotel_housekeeping_task_tree" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.tree</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <list string="Nhiệm Vụ Dọn Phòng"
                  decoration-muted="state == 'cancel'"
                  decoration-info="state == 'pending'"
                  decoration-warning="state == 'in_progress'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="room_id"/>
                <field name="room_type_id"/>
                <field name="task_type"/>
                <field name="priority" widget="priority"/>
                <field name="user_id"/>
                <field name="date_deadline"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'cancel'"
                       decoration-info="state == 'pending'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hotel_housekeeping_task_form" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.form</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <form string="Nhiệm Vụ Dọn Phòng">
                <header>
                    <button name="action_start" string="Bắt Đầu Dọn Dẹp" type="object" class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_complete" string="Hoàn Thành (Phòng Sạch)" type="object" class="btn-success" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Hủy Nhiệm Vụ" type="object" invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Mã Nhiệm Vụ</span>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Phòng &amp; Phân loại">
                            <field name="room_id"/>
                            <field name="room_type_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="task_type"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group string="Phân công &amp; Thời hạn">
                            <field name="user_id"/>
                            <field name="date_deadline"/>
                            <field name="booking_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ghi chú buồng phòng" name="notes">
                            <field name="notes" placeholder="Chi tiết yêu cầu dọn dẹp hoặc vật dụng cần thay thế..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hotel_housekeeping_task_search" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.search</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <search string="Tìm Nhiệm Vụ">
                <field name="name"/>
                <field name="room_id"/>
                <field name="user_id"/>
                <separator/>
                <filter string="Chờ Dọn" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Đang Dọn" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Đã Sạch" name="done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter string="Phòng" name="group_by_room" context="{'group_by': 'room_id'}"/>
                    <filter string="Trạng Thái" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Nhân Viên" name="group_by_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hotel_housekeeping_task" model="ir.actions.act_window">
        <field name="name">Nhiệm Vụ Dọn Phòng</field>
        <field name="res_model">hotel.housekeeping.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_pending': 1, 'search_default_in_progress': 1}</field>
    </record>
</odoo>
