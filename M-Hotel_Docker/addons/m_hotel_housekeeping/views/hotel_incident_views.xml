<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_incident_tree" model="ir.ui.view">
        <field name="name">hotel.incident.tree</field>
        <field name="model">hotel.incident</field>
        <field name="arch" type="xml">
            <list string="Sự Cố Buồng Phòng"
                  decoration-danger="severity == 'critical'"
                  decoration-warning="severity == 'medium'"
                  decoration-info="severity == 'low'"
                  decoration-muted="state == 'resolved'">
                <field name="name"/>
                <field name="title"/>
                <field name="room_id"/>
                <field name="severity" widget="badge"/>
                <field name="block_room" widget="boolean_toggle"/>
                <field name="user_id"/>
                <field name="create_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_incident_form" model="ir.ui.view">
        <field name="name">hotel.incident.form</field>
        <field name="model">hotel.incident</field>
        <field name="arch" type="xml">
            <form string="Sự Cố Buồng Phòng">
                <header>
                    <button name="action_start" string="Bắt Đầu Xử Lý" type="object" class="btn-primary" invisible="state != 'reported'"/>
                    <button name="action_resolve" string="Đã Khắc Phục Hoàn Tất" type="object" class="btn-success" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Hủy Sự Cố" type="object" invisible="state in ('resolved', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="reported,in_progress,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Mã Sự Cố</span>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin sự cố">
                            <field name="title" placeholder="VD: Điều hòa chảy nước, vỡ gương phòng tắm..."/>
                            <field name="room_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Mức độ &amp; Khóa phòng">
                            <field name="severity"/>
                            <field name="block_room"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mô tả sự cố &amp; Phương án giải quyết" name="description">
                            <group>
                                <field name="description" placeholder="Mô tả chi tiết biểu hiện hỏng hóc..."/>
                                <field name="resolution_note" placeholder="Ghi nhận phương án xử lý, linh kiện thay thế..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hotel_incident" model="ir.actions.act_window">
        <field name="name">Sự Cố &amp; Hư Hỏng Buồng Phòng</field>
        <field name="res_model">hotel.incident</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
