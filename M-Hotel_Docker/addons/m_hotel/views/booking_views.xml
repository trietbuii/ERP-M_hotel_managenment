<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Booking List View -->
    <record id="view_m_hotel_booking_tree" model="ir.ui.view">
        <field name="name">m.hotel.booking.tree</field>
        <field name="model">m.hotel.booking</field>
        <field name="arch" type="xml">
            <tree string="Danh sách đặt phòng" decoration-info="status == 'confirmed'" decoration-success="status == 'occupied'" decoration-muted="status == 'completed'" decoration-danger="status == 'cancelled'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="hotel_id"/>
                <field name="room_id"/>
                <field name="room_type_id"/>
                <field name="rent_type"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="total_amount" widget="monetary"/>
                <field name="deposit_amount" widget="monetary"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Booking Form View -->
    <record id="view_m_hotel_booking_form" model="ir.ui.view">
        <field name="name">m.hotel.booking.form</field>
        <field name="model">m.hotel.booking</field>
        <field name="arch" type="xml">
            <form string="Phiếu đặt phòng">
                <header>
                    <button name="action_confirm" string="Xác nhận đặt phòng" type="object" class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_check_in" string="📥 Nhận phòng (Check-in)" type="object" class="btn-success" invisible="status != 'confirmed'"/>
                    <button name="action_check_out" string="📤 Trả phòng (Check-out)" type="object" class="btn-danger" invisible="status != 'occupied'"/>
                    <button name="action_cancel" string="Hủy đặt phòng" type="object" class="btn-secondary" invisible="status in ['completed', 'cancelled']"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,confirmed,occupied,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Mã đặt phòng"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin khách hàng">
                            <field name="partner_id"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group string="Thông tin phòng &amp; Cơ sở">
                            <field name="hotel_id"/>
                            <field name="room_id"/>
                            <field name="room_type_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Hình thức &amp; Thời gian lưu trú">
                            <field name="rent_type"/>
                            <field name="check_in" invisible="rent_type == 'hour'"/>
                            <field name="check_out" invisible="rent_type == 'hour'"/>
                            <field name="hour_date" invisible="rent_type == 'night'"/>
                            <field name="hour_start" invisible="rent_type == 'night'"/>
                            <field name="hour_end" invisible="rent_type == 'night'"/>
                            <field name="hours_duration" invisible="rent_type == 'night'"/>
                        </group>
                        <group string="Chi phí &amp; Thanh toán (VNĐ)">
                            <field name="nights_count" invisible="rent_type == 'hour'"/>
                            <field name="unit_price"/>
                            <field name="deposit_amount"/>
                            <field name="total_amount" class="oe_subtotal_footer_separator text-primary font-weight-bold"/>
                        </group>
                    </group>
                    <group string="Yêu cầu đặc biệt của khách">
                        <field name="note" placeholder="Ví dụ: Cần check-in sớm, chuẩn bị thêm giường phụ hoặc xe máy..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Calendar View (Room Timeline & Calendar PMS) -->
    <record id="view_m_hotel_booking_calendar" model="ir.ui.view">
        <field name="name">m.hotel.booking.calendar</field>
        <field name="model">m.hotel.booking</field>
        <field name="arch" type="xml">
            <calendar string="Lịch đặt phòng khách sạn" date_start="check_in" date_stop="check_out" color="room_id" mode="week" scales="day,week,month">
                <field name="partner_id"/>
                <field name="room_id"/>
                <field name="phone"/>
                <field name="rent_type"/>
                <field name="total_amount"/>
                <field name="status"/>
            </calendar>
        </field>
    </record>

    <!-- Pivot View (Phân tích Báo cáo Doanh thu & Lượt đặt phòng) -->
    <record id="view_m_hotel_booking_pivot" model="ir.ui.view">
        <field name="name">m.hotel.booking.pivot</field>
        <field name="model">m.hotel.booking</field>
        <field name="arch" type="xml">
            <pivot string="Phân tích Doanh thu &amp; Đặt phòng">
                <field name="hotel_id" type="row"/>
                <field name="room_type_id" type="row"/>
                <field name="rent_type" type="col"/>
                <field name="total_amount" type="measure"/>
                <field name="nights_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View (Biểu đồ Doanh thu & Lượt phòng) -->
    <record id="view_m_hotel_booking_graph" model="ir.ui.view">
        <field name="name">m.hotel.booking.graph</field>
        <field name="model">m.hotel.booking</field>
        <field name="arch" type="xml">
            <graph string="Biểu đồ Doanh thu Khách sạn" type="bar">
                <field name="hotel_id"/>
                <field name="total_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_m_hotel_booking_search" model="ir.ui.view">
        <field name="name">m.hotel.booking.search</field>
        <field name="model">m.hotel.booking</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm đặt phòng">
                <field name="name" string="Mã đặt phòng"/>
                <field name="partner_id" string="Khách hàng"/>
                <field name="phone" string="Số điện thoại"/>
                <field name="room_id" string="Phòng"/>
                <separator/>
                <filter string="Thuê theo giờ" name="filter_hour" domain="[('rent_type', '=', 'hour')]"/>
                <filter string="Thuê theo đêm" name="filter_night" domain="[('rent_type', '=', 'night')]"/>
                <separator/>
                <filter string="Đã xác nhận" name="filter_confirmed" domain="[('status', '=', 'confirmed')]"/>
                <filter string="Đang lưu trú" name="filter_occupied" domain="[('status', '=', 'occupied')]"/>
                <filter string="Đã hoàn thành" name="filter_completed" domain="[('status', '=', 'completed')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Cơ sở / Chi nhánh" name="group_hotel" context="{'group_by': 'hotel_id'}"/>
                    <filter string="Hạng phòng" name="group_room_type" context="{'group_by': 'room_type_id'}"/>
                    <filter string="Phòng" name="group_room" context="{'group_by': 'room_id'}"/>
                    <filter string="Trạng thái" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Hình thức thuê" name="group_rent_type" context="{'group_by': 'rent_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_m_hotel_booking" model="ir.actions.act_window">
        <field name="name">Lịch Đặt Phòng &amp; PMS Calendar</field>
        <field name="res_model">m.hotel.booking</field>
        <field name="view_mode">calendar,tree,form,pivot,graph</field>
        <field name="search_view_id" ref="view_m_hotel_booking_search"/>
        <field name="context">{'search_default_filter_confirmed': 1, 'search_default_filter_occupied': 1}</field>
    </record>
</odoo>
