<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_m_hotel_service_request_tree" model="ir.ui.view">
        <field name="name">m.hotel.service.request.tree</field>
        <field name="model">m.hotel.service.request</field>
        <field name="arch" type="xml">
            <tree string="Sự vụ Buồng phòng &amp; Bảo trì" decoration-danger="priority == 'urgent'" decoration-warning="status == 'in_progress'" decoration-success="status == 'done'">
                <field name="name"/>
                <field name="room_id"/>
                <field name="request_type"/>
                <field name="user_id"/>
                <field name="priority" widget="badge"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_m_hotel_service_request_form" model="ir.ui.view">
        <field name="name">m.hotel.service.request.form</field>
        <field name="model">m.hotel.service.request</field>
        <field name="arch" type="xml">
            <form string="Nhiệm vụ Sự vụ">
                <header>
                    <button name="action_start" string="Bắt đầu xử lý / Bắt đầu dọn" type="object" class="btn-primary" invisible="status != 'new'"/>
                    <button name="action_done" string="✅ Hoàn thành (Mở lại phòng)" type="object" class="btn-success" invisible="status != 'in_progress'"/>
                    <field name="status" widget="statusbar" statusbar_visible="new,in_progress,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Nội dung công việc"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="room_id"/>
                            <field name="request_type"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="priority"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_m_hotel_service_request" model="ir.actions.act_window">
        <field name="name">Sự vụ &amp; Bảo trì</field>
        <field name="res_model">m.hotel.service.request</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
