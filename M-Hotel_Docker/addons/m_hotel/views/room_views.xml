<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== ROOM TYPE VIEWS ==================== -->
    <record id="view_m_hotel_room_type_tree" model="ir.ui.view">
        <field name="name">m.hotel.room.type.tree</field>
        <field name="model">m.hotel.room.type</field>
        <field name="arch" type="xml">
            <tree string="Hạng phòng">
                <field name="code"/>
                <field name="name"/>
                <field name="price_night" widget="monetary"/>
                <field name="price_hour" widget="monetary"/>
                <field name="capacity"/>
                <field name="bed_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_m_hotel_room_type_form" model="ir.ui.view">
        <field name="name">m.hotel.room.type.form</field>
        <field name="model">m.hotel.room.type</field>
        <field name="arch" type="xml">
            <form string="Hạng phòng">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Tên hạng phòng"/>
                        <h1><field name="name" placeholder="Ví dụ: Deluxe Ocean View"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="price_night"/>
                            <field name="price_hour"/>
                        </group>
                        <group>
                            <field name="capacity"/>
                            <field name="bed_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="amenities" placeholder="Ban công, Hướng biển, Tivi 55 inch, Điều hòa Inverter..."/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_m_hotel_room_type" model="ir.actions.act_window">
        <field name="name">Hạng phòng</field>
        <field name="res_model">m.hotel.room.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ==================== ROOM VIEWS ==================== -->
    <record id="view_m_hotel_room_tree" model="ir.ui.view">
        <field name="name">m.hotel.room.tree</field>
        <field name="model">m.hotel.room</field>
        <field name="arch" type="xml">
            <tree string="Danh sách phòng" decoration-success="status == 'available'" decoration-danger="status == 'maintenance'" decoration-warning="status == 'cleaning'" decoration-info="status == 'confirmed'">
                <field name="name"/>
                <field name="hotel_id"/>
                <field name="room_type_id"/>
                <field name="floor"/>
                <field name="price_night"/>
                <field name="price_hour"/>
                <field name="status" widget="badge"/>
                <field name="current_guest"/>
            </tree>
        </field>
    </record>

    <record id="view_m_hotel_room_form" model="ir.ui.view">
        <field name="name">m.hotel.room.form</field>
        <field name="model">m.hotel.room</field>
        <field name="arch" type="xml">
            <form string="Thông tin phòng">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="available,confirmed,occupied,cleaning,maintenance"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Số phòng"/>
                        <h1><field name="name" placeholder="Ví dụ: P.101"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="hotel_id"/>
                            <field name="room_type_id"/>
                            <field name="floor"/>
                        </group>
                        <group>
                            <field name="price_night"/>
                            <field name="price_hour"/>
                            <field name="capacity"/>
                            <field name="current_guest"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lịch đặt phòng">
                            <field name="booking_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="check_in"/>
                                    <field name="check_out"/>
                                    <field name="total_amount"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Lịch sử Sự vụ / Bảo trì">
                            <field name="service_request_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="request_type"/>
                                    <field name="priority"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Room Kanban View -->
    <record id="view_m_hotel_room_kanban" model="ir.ui.view">
        <field name="name">m.hotel.room.kanban</field>
        <field name="model">m.hotel.room</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="name"/>
                <field name="room_type_id"/>
                <field name="hotel_id"/>
                <field name="price_night"/>
                <field name="status"/>
                <field name="current_guest"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click p-2 border rounded shadow-sm bg-white">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="fs-5 text-primary"><field name="name"/></strong>
                                <field name="status" widget="badge"/>
                            </div>
                            <div class="text-muted small mb-1"><field name="room_type_id"/> &#8226; <field name="hotel_id"/></div>
                            <div class="fw-bold text-success mb-1"><field name="price_night"/> VNĐ/đêm</div>
                            <div t-if="record.current_guest.raw_value" class="text-danger small">
                                👤 Khách đang ở: <strong><field name="current_guest"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_m_hotel_room" model="ir.actions.act_window">
        <field name="name">Danh sách phòng</field>
        <field name="res_model">m.hotel.room</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
</odoo>
