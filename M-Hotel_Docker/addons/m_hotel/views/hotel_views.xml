<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_m_hotel_tree" model="ir.ui.view">
        <field name="name">m.hotel.tree</field>
        <field name="model">m.hotel</field>
        <field name="arch" type="xml">
            <tree string="Cơ sở khách sạn">
                <field name="code"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="room_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_m_hotel_form" model="ir.ui.view">
        <field name="name">m.hotel.form</field>
        <field name="model">m.hotel</field>
        <field name="arch" type="xml">
            <form string="Cơ sở khách sạn">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Tên cơ sở / Chi nhánh"/>
                        <h1><field name="name" placeholder="Ví dụ: M-Hotel Quy Nhơn Beach"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="room_count"/>
                        </group>
                    </group>
                    <group>
                        <field name="address"/>
                    </group>
                    <notebook>
                        <page string="Danh sách phòng">
                            <field name="room_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="room_type_id"/>
                                    <field name="price_night"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_m_hotel" model="ir.actions.act_window">
        <field name="name">Cơ sở khách sạn</field>
        <field name="res_model">m.hotel</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
