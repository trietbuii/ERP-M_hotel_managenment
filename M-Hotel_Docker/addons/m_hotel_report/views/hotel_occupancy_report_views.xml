<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pivot View -->
    <record id="view_hotel_occupancy_report_pivot" model="ir.ui.view">
        <field name="name">hotel.occupancy.report.pivot</field>
        <field name="model">hotel.occupancy.report</field>
        <field name="arch" type="xml">
            <pivot string="Phân Tích Doanh Thu &amp; Công Suất" sample="1">
                <field name="company_id" type="row" groups="base.group_multi_company"/>
                <field name="room_type_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="amount_room" type="measure"/>
                <field name="amount_services" type="measure"/>
                <field name="amount_total" type="measure"/>
                <field name="nights_count" type="measure"/>
                <field name="hours_duration" type="measure"/>
                <field name="booking_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_hotel_occupancy_report_graph" model="ir.ui.view">
        <field name="name">hotel.occupancy.report.graph</field>
        <field name="model">hotel.occupancy.report</field>
        <field name="arch" type="xml">
            <graph string="Xu Hướng Doanh Thu Khách Sạn" type="bar" sample="1">
                <field name="date" interval="month"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hotel_occupancy_report_search" model="ir.ui.view">
        <field name="name">hotel.occupancy.report.search</field>
        <field name="model">hotel.occupancy.report</field>
        <field name="arch" type="xml">
            <search string="Tìm Kiếm &amp; Lọc Báo Cáo">
                <field name="room_id"/>
                <field name="room_type_id"/>
                <field name="partner_id"/>
                <separator/>
                <filter string="Thuê Theo Đêm" name="night_only" domain="[('rent_type', '=', 'night')]"/>
                <filter string="Thuê Theo Giờ" name="hour_only" domain="[('rent_type', '=', 'hour')]"/>
                <separator/>
                <filter string="Năm Nay" name="this_year" domain="[('date', '&gt;=', context_today().strftime('%Y-01-01'))]"/>
                <group>
                    <filter string="Cơ Sở / Chi Nhánh" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    <filter string="Hạng Phòng" name="group_by_type" context="{'group_by': 'room_type_id'}"/>
                    <filter string="Phòng" name="group_by_room" context="{'group_by': 'room_id'}"/>
                    <filter string="Hình Thức Thuê" name="group_by_rent_type" context="{'group_by': 'rent_type'}"/>
                    <filter string="Tháng Lưu Trú" name="group_by_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hotel_occupancy_report" model="ir.actions.act_window">
        <field name="name">Báo Cáo Doanh Thu &amp; Công Suất</field>
        <field name="res_model">hotel.occupancy.report</field>
        <field name="view_mode">pivot,graph</field>
        <field name="context">{'search_default_group_by_type': 1}</field>
    </record>
</odoo>
