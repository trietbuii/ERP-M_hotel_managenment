<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_equipment_request_view_form_hotel_inherit" model="ir.ui.view">
        <field name="name">maintenance.request.form.hotel.inherit</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='equipment_id']" position="before">
                <field name="room_id"/>
            </xpath>
            <xpath expr="//field[@name='equipment_id']" position="after">
                <field name="incident_id" readonly="1" invisible="not incident_id"/>
            </xpath>
        </field>
    </record>

    <record id="hr_equipment_request_view_tree_hotel_inherit" model="ir.ui.view">
        <field name="name">maintenance.request.tree.hotel.inherit</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="room_id"/>
            </xpath>
        </field>
    </record>
</odoo>
