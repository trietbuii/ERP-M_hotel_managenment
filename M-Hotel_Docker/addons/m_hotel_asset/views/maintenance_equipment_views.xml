<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_equipment_view_form_hotel_inherit" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.hotel.inherit</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="room_id" placeholder="Chọn phòng lắp đặt thiết bị này..."/>
            </xpath>
        </field>
    </record>

    <record id="hr_equipment_view_tree_hotel_inherit" model="ir.ui.view">
        <field name="name">maintenance.equipment.tree.hotel.inherit</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="room_id"/>
            </xpath>
        </field>
    </record>
</odoo>
