<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban View: Sơ Đồ Trực Quan Buồng Phòng -->
    <record id="view_hotel_room_kanban" model="ir.ui.view">
        <field name="name">hotel.room.kanban</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <kanban default_group_by="floor" class="o_kanban_small_column" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="floor"/>
                <field name="room_type_id"/>
                <field name="company_id"/>
                <field name="status"/>
                <field name="price_night"/>
                <field name="current_guest"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_color_#{record.color.raw_value} oe_kanban_global_click p-2 shadow-sm rounded border">
                            <div class="o_kanban_record_top mb-1">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title text-primary fs-5">
                                        <field name="name"/>
                                    </strong>
                                    <span class="text-muted d-block small">
                                        <field name="room_type_id"/>
                                    </span>
                                </div>
                                <span t-if="record.status.raw_value == 'available'" class="badge text-bg-success">Trống</span>
                                <span t-if="record.status.raw_value == 'reserved'" class="badge text-bg-warning">Đã đặt</span>
                                <span t-if="record.status.raw_value == 'occupied'" class="badge text-bg-danger">Đang ở</span>
                                <span t-if="record.status.raw_value == 'cleaning'" class="badge text-bg-info">Cần dọn</span>
                                <span t-if="record.status.raw_value == 'maintenance'" class="badge text-bg-secondary">Bảo trì</span>
                                <span t-if="record.status.raw_value == 'out_of_service'" class="badge text-bg-dark">Khóa</span>
                            </div>
                            <div class="o_kanban_record_body my-1">
                                <div t-if="record.current_guest.raw_value" class="text-truncate">
                                    <i class="fa fa-user me-1 text-danger" title="Khách đang ở"/>
                                    <strong class="small"><field name="current_guest"/></strong>
                                </div>
                                <div class="text-muted small">
                                    <i class="fa fa-money me-1" title="Giá phòng"/>
                                    <field name="price_night" widget="monetary"/>/đêm
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2 pt-1 border-top d-flex justify-content-between align-items-center">
                                <span class="small text-muted"><field name="floor"/></span>
                                <div class="btn-group btn-group-sm">
                                    <button t-if="record.status.raw_value != 'available'" name="action_set_available" type="object" class="btn btn-outline-success btn-sm py-0 px-1" title="Chuyển sang Sẵn sàng">
                                        <i class="fa fa-check"/>
                                    </button>
                                    <button t-if="record.status.raw_value != 'cleaning'" name="action_set_cleaning" type="object" class="btn btn-outline-info btn-sm py-0 px-1" title="Báo Cần dọn">
                                        <i class="fa fa-broom"/>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_hotel_room_tree" model="ir.ui.view">
        <field name="name">hotel.room.tree</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <list string="Danh Sách Phòng"
                  decoration-success="status == 'available'"
                  decoration-warning="status == 'reserved'"
                  decoration-danger="status == 'occupied'"
                  decoration-info="status == 'cleaning'"
                  decoration-muted="status in ('maintenance', 'out_of_service')">
                <field name="name"/>
                <field name="floor"/>
                <field name="room_type_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="price_night" widget="monetary"/>
                <field name="price_hour" widget="monetary"/>
                <field name="current_guest"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'available'"
                       decoration-warning="status == 'reserved'"
                       decoration-danger="status == 'occupied'"
                       decoration-info="status == 'cleaning'"
                       decoration-muted="status in ('maintenance', 'out_of_service')"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hotel_room_form" model="ir.ui.view">
        <field name="name">hotel.room.form</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form string="Phòng Khách Sạn">
                <header>
                    <button name="action_set_available" string="Sẵn Sàng Đón Khách" type="object" class="btn-primary" invisible="status == 'available'"/>
                    <button name="action_set_cleaning" string="Cần Dọn Buồng" type="object" class="btn-info" invisible="status == 'cleaning'"/>
                    <button name="action_set_maintenance" string="Báo Bảo Trì" type="object" invisible="status == 'maintenance'"/>
                    <button name="action_set_out_of_service" string="Khóa Phòng" type="object" invisible="status == 'out_of_service'"/>
                    <field name="status" widget="statusbar" statusbar_visible="available,reserved,occupied,cleaning"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Số phòng"/>
                        <h1><field name="name" placeholder="VD: P.101"/></h1>
                    </div>
                    <group>
                        <group string="Vị trí &amp; Hạng phòng">
                            <field name="room_type_id"/>
                            <field name="floor"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Giá phòng &amp; Khách hiện tại">
                            <field name="price_night"/>
                            <field name="price_hour"/>
                            <field name="current_guest" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ghi chú &amp; Đặc điểm" name="notes">
                            <field name="note" placeholder="VD: Cửa sổ hướng hồ bơi, phòng cạnh thang máy..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hotel_room_search" model="ir.ui.view">
        <field name="name">hotel.room.search</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <search string="Tìm Kiếm Phòng">
                <field name="name"/>
                <field name="floor"/>
                <field name="room_type_id"/>
                <field name="current_guest"/>
                
                <separator/>
                <filter string="Phòng Trống (Sẵn sàng)" name="available" domain="[('status', '=', 'available')]"/>
                <filter string="Đã Đặt Trước" name="reserved" domain="[('status', '=', 'reserved')]"/>
                <filter string="Đang Có Khách Ở" name="occupied" domain="[('status', '=', 'occupied')]"/>
                <filter string="Cần Dọn Dẹp" name="cleaning" domain="[('status', '=', 'cleaning')]"/>
                <filter string="Đang Bảo Trì / Khóa" name="maintenance" domain="[('status', 'in', ('maintenance', 'out_of_service'))]"/>
                
                <group>
                    <filter string="Tầng" name="group_by_floor" context="{'group_by': 'floor'}"/>
                    <filter string="Hạng Phòng" name="group_by_room_type" context="{'group_by': 'room_type_id'}"/>
                    <filter string="Trạng Thái" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Chi Nhánh" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_hotel_room_map" model="ir.actions.act_window">
        <field name="name">Sơ Đồ Phòng Trực Quan</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_by_floor': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Xem trực quan sơ đồ buồng phòng theo tầng và màu trạng thái
            </p>
        </field>
    </record>

    <record id="action_hotel_room_list" model="ir.actions.act_window">
        <field name="name">Danh Mục Tất Cả Phòng</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
</odoo>
