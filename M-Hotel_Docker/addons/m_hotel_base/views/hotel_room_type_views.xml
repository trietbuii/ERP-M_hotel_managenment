<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_hotel_room_type_tree" model="ir.ui.view">
        <field name="name">hotel.room.type.tree</field>
        <field name="model">hotel.room.type</field>
        <field name="arch" type="xml">
            <list string="Hạng Phòng">
                <field name="code"/>
                <field name="name"/>
                <field name="capacity"/>
                <field name="bed_type"/>
                <field name="base_price_night" widget="monetary" options="{'digits': [16, 0]}"/>
                <field name="base_price_hour" widget="monetary" options="{'digits': [16, 0]}"/>
                <field name="room_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hotel_room_type_form" model="ir.ui.view">
        <field name="name">hotel.room.type.form</field>
        <field name="model">hotel.room.type</field>
        <field name="arch" type="xml">
            <form string="Hạng Phòng">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Tên hạng phòng"/>
                        <h1><field name="name" placeholder="VD: Deluxe King Hướng Biển"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin chung">
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="capacity"/>
                            <field name="extra_capacity"/>
                            <field name="bed_type"/>
                            <field name="active"/>
                        </group>
                        <group string="Chính sách giá cơ bản">
                            <field name="base_price_night" options="{'digits': [16, 0]}"/>
                            <field name="base_price_hour" options="{'digits': [16, 0]}"/>
                            <field name="room_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tiện ích &amp; Mô tả" name="description">
                            <group>
                                <field name="amenities" placeholder="VD: Smart TV 55 inch, Ban công nhìn biển, Bồn tắm nằm nằm, Minibar cao cấp..."/>
                                <field name="description" placeholder="Mô tả trải nghiệm phòng dành cho khách..."/>
                            </group>
                        </page>
                        <page string="Biểu giá theo mùa &amp; Dịp lễ" name="rates">
                            <field name="rate_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="rate_type"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="price_night" options="{'digits': [16, 0]}"/>
                                    <field name="price_hour" options="{'digits': [16, 0]}"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Danh sách phòng hiện có" name="rooms">
                            <field name="room_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="floor"/>
                                    <field name="status" widget="badge"/>
                                    <field name="current_guest"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hotel_room_type" model="ir.actions.act_window">
        <field name="name">Hạng Phòng</field>
        <field name="res_model">hotel.room.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo hạng phòng đầu tiên (Standard, Deluxe, Suite...)
            </p>
        </field>
    </record>
</odoo>
