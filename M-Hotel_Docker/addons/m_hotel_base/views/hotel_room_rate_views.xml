<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_room_rate_tree" model="ir.ui.view">
        <field name="name">hotel.room.rate.tree</field>
        <field name="model">hotel.room.rate</field>
        <field name="arch" type="xml">
            <list string="Bảng Giá Theo Mùa">
                <field name="name"/>
                <field name="room_type_id"/>
                <field name="rate_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="price_night" widget="monetary" options="{'digits': [16, 0]}"/>
                <field name="price_hour" widget="monetary" options="{'digits': [16, 0]}"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_room_rate_form" model="ir.ui.view">
        <field name="name">hotel.room.rate.form</field>
        <field name="model">hotel.room.rate</field>
        <field name="arch" type="xml">
            <form string="Bảng Giá Theo Mùa">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Tên bảng giá"/>
                        <h1><field name="name" placeholder="VD: Mùa Hè Cao Điểm 2026"/></h1>
                    </div>
                    <group>
                        <group string="Phạm vi áp dụng">
                            <field name="room_type_id"/>
                            <field name="rate_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Thời gian &amp; Giá áp dụng">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="price_night" options="{'digits': [16, 0]}"/>
                            <field name="price_hour" options="{'digits': [16, 0]}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hotel_room_rate" model="ir.actions.act_window">
        <field name="name">Giá Theo Mùa &amp; Dịp Lễ</field>
        <field name="res_model">hotel.room.rate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
